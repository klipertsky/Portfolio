      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "content": "⚙️ Technologies Used\nn8n — workflow automation and orchestration\nTelegram Bot API — receiving and sending messages\nAI Agent — processing user requests and generating responses\nAI Language Model — natural-language understanding and response generation\nConversation Memory — maintaining conversational context\nDocker — running n8n locally\nTailscale Funnel — providing secure HTTPS access for Telegram webhooks",
        "height": 352,

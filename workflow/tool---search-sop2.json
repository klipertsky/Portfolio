        "jsCode": "const sops = [\n  {\n    title: \"SOP - Edge Banding\",\n    keywords: [\"edge\", \"banding\"],\n    content:\n      \"Verify the panel code and confirm the required operation is Edge Banding before processing.\",\n    source: \"SOP - Edge Banding\"\n  },\n  {\n    title: \"SOP - Drilling\",\n    keywords: [\"drill\", \"drilling\"],\n    content:\n      \"Verify the panel code and confirm the required operation is Drilling before processing.\",\n    source: \"SOP - Drilling\"\n  }\n];\n\nconst query = ($json.query || \"\").toLowerCase();\n\nconst results = sops.filter(sop =>\n  sop.keywords.some(keyword => query.includes(keyword))\n);\n\nreturn [{\n  json: {\n    found: results.length > 0,\n    results,\n    source: \"SOP Knowledge Base\"\n  }\n}];"
      },
